      <arf:content>
        <ds:data-stream-collection id="scap_org.open-scap_collection_from_xccdf_ssg-rhel9-xccdf.xml">
          <ds:component id="scap_org.open-scap_comp_ssg-rhel9-xccdf.xml">
            <xccdf:Benchmark id="xccdf_org.ssgproject.content_benchmark_RHEL-9" resolved="1">
              <xccdf:status>draft</xccdf:status>
              <xccdf:title>Guide to the Secure Configuration of Red Hat Enterprise Linux 9</xccdf:title>
              <xccdf:version>0.1.72</xccdf:version>
              <xccdf:Profile id="xccdf_org.ssgproject.content_profile_cis_server_l1">
                <xccdf:title>CIS Red Hat Enterprise Linux 9 Benchmark for Level 1 - Server</xccdf:title>
              </xccdf:Profile>
              <xccdf:Group id="xccdf_org.ssgproject.content_group_services">
                <xccdf:title>Services</xccdf:title>
                <xccdf:Rule id="xccdf_org.ssgproject.content_rule_sshd_disable_root_login" severity="medium" selected="false">
                  <xccdf:title>Disable SSH Root Login</xccdf:title>
                  <xccdf:description>The root user should never be allowed to login directly over a network.</xccdf:description>
                  <xccdf:reference href="https://www.cisecurity.org/benchmark/red_hat_linux/">5.2.10</xccdf:reference>
                  <xccdf:reference href="https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r4.pdf">AC-6(2),AC-17(a)</xccdf:reference>
                  <xccdf:reference href="https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r4.pdf">IA-2</xccdf:reference>
                  <xccdf:ident system="https://ncp.nist.gov/cce">CCE-90799-3</xccdf:ident>
                </xccdf:Rule>
                <xccdf:Rule id="xccdf_org.ssgproject.content_rule_rsyslog_remote_loghost" severity="medium">
                  <xccdf:title>Ensure Logs Sent To Remote Host</xccdf:title>
                  <xccdf:reference href="https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r4.pdf">AU-4(1),AU-9(2)</xccdf:reference>
                </xccdf:Rule>
                <xccdf:Rule id="xccdf_org.ssgproject.content_rule_service_auditd_enabled" severity="medium">
                  <xccdf:title>Enable <xhtml:code>auditd</xhtml:code> Service</xccdf:title>
                  <xccdf:reference href="https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r4.pdf">AU-12,CM-6(a)</xccdf:reference>
                </xccdf:Rule>
              </xccdf:Group>
              <xccdf:Group id="xccdf_org.ssgproject.content_group_system">
                <xccdf:title>System Settings</xccdf:title>
                <xccdf:Rule id="xccdf_org.ssgproject.content_rule_partition_for_var_log_audit" severity="low">
                  <xccdf:title>Ensure /var/log/audit Located On Separate Partition</xccdf:title>
                  <xccdf:reference href="https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r4.pdf">AU-4,SC-5(2)</xccdf:reference>
                </xccdf:Rule>
                <xccdf:Rule id="xccdf_org.ssgproject.content_rule_grub2_password" severity="high">
                  <xccdf:title>Set Boot Loader Password in grub2</xccdf:title>
                  <xccdf:reference href="https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r4.pdf">AC-3,CM-6(a)</xccdf:reference>
                </xccdf:Rule>
                <xccdf:Rule id="xccdf_org.ssgproject.content_rule_package_aide_installed" severity="medium">
                  <xccdf:title>Install AIDE</xccdf:title>
                  <xccdf:reference href="https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r4.pdf">CM-6(a),SI-7,SI-7(1)</xccdf:reference>
                </xccdf:Rule>
                <xccdf:Rule id="xccdf_org.ssgproject.content_rule_selinux_state" severity="high">
                  <xccdf:title>Ensure SELinux State is Enforcing</xccdf:title>
                  <xccdf:reference href="https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r4.pdf">AC-3,AC-3(3)(a)</xccdf:reference>
                </xccdf:Rule>
                <xccdf:Rule id="xccdf_org.ssgproject.content_rule_sysctl_net_ipv6_conf_all_accept_ra" severity="medium">
                  <xccdf:title>Disable Accepting Router Advertisements on all IPv6 Interfaces</xccdf:title>
                  <xccdf:reference href="https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r4.pdf">CM-6(a),CM-7(a)</xccdf:reference>
                </xccdf:Rule>
                <xccdf:Rule id="xccdf_org.ssgproject.content_rule_accounts_tmout" severity="medium">
                  <xccdf:title>Set Interactive Session Timeout</xccdf:title>
                  <xccdf:reference href="https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r4.pdf">AC-12,SC-10</xccdf:reference>
                </xccdf:Rule>
                <xccdf:Rule id="xccdf_org.ssgproject.content_rule_firewalld_loopback_traffic_trusted" severity="medium">
                  <xccdf:title>Configure the Firewalld Ports | Loopback</xccdf:title>
                </xccdf:Rule>
                <xccdf:Rule id="xccdf_org.ssgproject.content_rule_kernel_module_usb-storage_disabled" severity="medium">
                  <xccdf:title>Disable Modprobe Loading of USB Storage Driver | usb-storage</xccdf:title>
                </xccdf:Rule>
              </xccdf:Group>
            </xccdf:Benchmark>
          </ds:component>
        </ds:data-stream-collection>
      </arf:content>
    </arf:report-request>
